# Cruzial Local - configuración común para Windows y macOS.
# Copia este archivo como .env y ajusta la ruta si mueves la BBDD.
#
# Windows:
# CRUZIAL_DB_PATH=data/cruzial_crm.db
# CRUZIAL_DB_PATH=Z:\Cruzial\Datos\cruzial_crm.db
# CRUZIAL_DB_PATH=\\SERVIDOR\Compartido\Cruzial\cruzial_crm.db
#
# macOS (recurso compartido montado primero desde Finder):
# CRUZIAL_DB_PATH=/Volumes/Empresa/Cruzial/cruzial_crm.db
# CRUZIAL_DB_PATH=/Users/tu_usuario/Cruzial/cruzial_crm.db
CRUZIAL_DB_PATH=data/cruzial_crm.db
CRUZIAL_DB_TIMEOUT_SECONDS=20
CRUZIAL_LOG_DIR=logs

# Genera una cadena aleatoria larga y mantenla estable en cada equipo que
# comparta la misma BBDD. Los instaladores crean una automáticamente si falta.
SMTP_CREDENTIALS_SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_LARGA
SMTP_TEST_TIMEOUT_SECONDS=8

# Opcional: solo si Chrome está instalado en una ruta no estándar.
# macOS normal: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROME_BIN=/ruta/a/Google Chrome
# CHROMEDRIVER_PATH=/ruta/a/chromedriver
