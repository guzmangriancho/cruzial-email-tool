# Copia este archivo como .env y ajusta la ruta.
# Ejemplos:
# CRUZIAL_DB_PATH=data\cruzial_crm.db
# CRUZIAL_DB_PATH=Z:\Cruzial\Datos\cruzial_crm.db
# CRUZIAL_DB_PATH=\\SERVIDOR\Compartido\Cruzial\cruzial_crm.db
CRUZIAL_DB_PATH=data\cruzial_crm.db
CRUZIAL_DB_TIMEOUT_SECONDS=20
CRUZIAL_LOG_DIR=logs

# Genera una cadena aleatoria larga y mantenla estable en esta instalación.
SMTP_CREDENTIALS_SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_LARGA
SMTP_TEST_TIMEOUT_SECONDS=8
